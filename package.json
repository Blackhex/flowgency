{
  "name": "flowgency-ui-gate",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss --config tailwind.config.cjs --input tools/tailwind.css --output flowgency/static/tailwind.css --minify",
    "build:terminal": "esbuild tools/setup-terminal.js --bundle --format=iife --target=es2020 --minify --legal-comments=external --outfile=flowgency/static/setup-terminal.js",
    "test:ui": "playwright test",
    "test:ui:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.52.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "lucide": "0.468.0",
    "tailwindcss": "3.4.17",
    "yaml": "^2.8.1"
  }
}
