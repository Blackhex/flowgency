{
  "inputs": [
    {
      "description": "pytest -k keyword expression (e.g. 'copilot or dispatch')",
      "id": "testKeyword",
      "type": "promptString"
    },
    {
      "args": "http://127.0.0.1:8500",
      "command": "simpleBrowser.show",
      "id": "openDashboard",
      "type": "command"
    }
  ],
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "args": [
        "-m",
        "pip",
        "install",
        "-e",
        "."
      ],
      "command": "python",
      "detail": "pip install -e . — install the package and dependencies in editable mode",
      "group": "build",
      "label": "Hidden/Install editable",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "pytest",
        "tests/",
        "-q"
      ],
      "command": "python",
      "detail": "Run the full pytest suite",
      "group": {
        "isDefault": true,
        "kind": "test"
      },
      "label": "Tests/Run all",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "pytest",
        "tests/",
        "-v"
      ],
      "command": "python",
      "detail": "Run the full pytest suite with verbose output",
      "group": "test",
      "label": "Tests/Run all verbose",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "pytest",
        "${file}",
        "-v"
      ],
      "command": "python",
      "detail": "Run pytest against the currently open test file",
      "group": "test",
      "label": "Tests/Run current file",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "pytest",
        "tests/",
        "-v",
        "-k",
        "${input:testKeyword}"
      ],
      "command": "python",
      "detail": "Run pytest filtered by a -k keyword expression",
      "group": "test",
      "label": "Tests/Run by keyword",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "serve",
        "--host",
        "127.0.0.1"
      ],
      "command": "christag-agency",
      "detail": "Start Agency dashboard on http://127.0.0.1:8500",
      "group": "none",
      "isBackground": true,
      "label": "Dashboard/Serve",
      "problemMatcher": {
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*",
          "endsPattern": ".*Application startup complete.*"
        },
        "pattern": {
          "file": 1,
          "location": 1,
          "message": 1,
          "regexp": "^(.*)$"
        }
      },
      "type": "shell"
    },
    {
      "args": [
        "serve",
        "--reload",
        "--host",
        "127.0.0.1"
      ],
      "command": "christag-agency",
      "detail": "Start the Agency dashboard with hot-reload on http://127.0.0.1:8500",
      "group": "none",
      "hide": true,
      "isBackground": true,
      "label": "Hidden/Serve hot-reload",
      "problemMatcher": {
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*",
          "endsPattern": ".*Application startup complete.*"
        },
        "pattern": {
          "file": 1,
          "location": 1,
          "message": 1,
          "regexp": "^(.*)$"
        }
      },
      "type": "shell"
    },
    {
      "command": "${input:openDashboard}",
      "hide": true,
      "label": "Hidden/Open dashboard",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "dependsOn": [
        "Hidden/Install editable",
        "Hidden/Serve hot-reload",
        "Hidden/Open dashboard"
      ],
      "dependsOrder": "sequence",
      "detail": "Start the Agency dashboard with hot-reload and open it internally on http://127.0.0.1:8500",
      "group": "none",
      "label": "Dashboard/Serve hot-reload"
    },
    {
      "args": [
        "-m",
        "agency.cli",
        "status"
      ],
      "command": "python",
      "detail": "Fleet overview across all groups",
      "group": "none",
      "label": "CLI/Status",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "agency.cli",
        "inbox"
      ],
      "command": "python",
      "detail": "Show what needs attention",
      "group": "none",
      "label": "CLI/Inbox",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "agency.cli",
        "agents"
      ],
      "command": "python",
      "detail": "List agents with health status",
      "group": "none",
      "label": "CLI/Agents",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "args": [
        "-m",
        "agency.dispatch.run",
        "--config",
        "${workspaceFolder}/config.yaml"
      ],
      "command": "python",
      "detail": "Run the dispatch runner a single time against config.yaml",
      "group": "none",
      "label": "Dispatch/Run once",
      "problemMatcher": [],
      "type": "shell"
    }
  ],
  "version": "2.0.0"
}