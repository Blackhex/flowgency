schema_version: 1
# Set FLOWGENCY_CONFIG to the path of this file to make it the authoritative config.
flowgency:
  title: Flowgency
  default_team: my-project
  ai_backend: copilot
  dispatch:
    interval: 15
  jobs:
    pool: 4
  agent_library: C:/Flowgency/agent-library
  compilation_cache: C:/Flowgency/compiled-agents
  memory_store: C:/Flowgency/memory
  prompt_store: C:/Flowgency/prompts
  workflow_library: C:/Flowgency/workflow-library

memory:
  channels:
    product-strategy:
      display_name: Product Strategy

teams:
  my-project:
    name: My Project
    workspace_path: C:/Projects/my-project
    path: C:/Flowgency/teams/my-project
    default_integration: copilot
    permissions:
      mode: restricted
      rules:
        - path: C:/Projects/my-project
          tools: [read, search]
    runtime:
      timeout: 1800
    dispatch:
      enabled: true
    # Optional: allow Git-format evidence capture (artifact_format: git-change)
    # for this team's tickets. Local-only; no remote or authentication fields.
    # git_publication:
    #   mode: local
    #   allowed_refs: []
    workflows:
      project-delivery:
        name: Delivery
        blueprint: software-delivery
        integration: local
        integration_config:
          root: C:/Flowgency/tickets
    agents:
      - name: builder
        blueprint: builder
        integration: copilot
        integration_config:
          # Runtime label: Allow local-network access.
          # Disclosure: Allows connections to local services and LAN hosts, not only Flowgency.
          # Keep false by default. Restricted ticket runs require explicit opt-in;
          # otherwise Flowgency fails preflight with ticket-local-network-required.
          allow_local_network: false
        identity:
          display_name: Builder
          title: Implementation Lead
        permissions:
          rules:
            - path: C:/Projects/my-project
              tools: [read, search, write]
            - path: C:/Research/my-project
              tools: [read, search]
        runtime: {}
        default_memory:
          scope: agent
        routines:
          - id: daily-review
            prompt:
              scope: blueprint
              name: daily-review
            schedule:
              at: "09:00"
              catch_up: today
            memory:
              scope: routine
          - id: strategy-review
            prompt:
              scope: blueprint
              name: strategy-review
            schedule:
              every: 7d
            memory:
              scope: channel
              channel: product-strategy
      - name: advisor
        blueprint: advisor
        integration: copilot
        integration_config:
          allow_local_network: false
    workspaces:
      - name: Main workspace
        type: ide
        config:
          ide_name: VS Code
          project_path: C:/Projects/my-project
