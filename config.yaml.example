schema_version: 6
agency:
  title: Agency
  default_team: my-project
  ai_backend: copilot
  dispatch:
    interval: 15
  jobs:
    pool: 4
  agent_library: C:/Agency/agent-library
  compilation_cache: C:/Agency/compiled-agents
  memory_store: C:/Agency/memory
  prompt_store: C:/Agency/prompts

memory:
  channels:
    product-strategy:
      display_name: Product Strategy

teams:
  my-project:
    name: My Project
    workspace_path: C:/Projects/my-project
    path: C:/Agency/teams/my-project
    default_integration: copilot
    runtime:
      timeout: 1800
      permissions:
        mode: restricted
        rules:
          - path: C:/Projects/my-project
            tools: [read, search]
    dispatch:
      enabled: true
    agents:
      - name: builder
        blueprint: builder
        integration: copilot
        identity:
          display_name: Builder
          title: Implementation Lead
        runtime:
          permissions:
            rules:
              - path: C:/Projects/my-project
                tools: [read, search, write]
              - path: C:/Research/my-project
                tools: [read, search]
        default_memory:
          scope: agent
        routines:
          - id: daily-review
            prompt:
              scope: blueprint
              name: daily-review
            schedule:
              at: "09:00"
              catch_up: today
            memory:
              scope: routine
          - id: strategy-review
            prompt:
              scope: blueprint
              name: strategy-review
            schedule:
              every: 7d
            memory:
              scope: channel
              channel: product-strategy
      - name: advisor
        blueprint: advisor
        integration: copilot
    workspaces:
      - name: Main workspace
        type: ide
        config:
          ide_name: VS Code
          project_path: C:/Projects/my-project
